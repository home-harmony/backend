# FamilyLedger Environment Configuration Template
# Copy this file to .env.dev, .env.staging, or .env.prod and populate with actual AWS resource outputs.

# AWS Region & Environment
AWS_REGION=us-east-1
ENVIRONMENT=dev

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX

# API Gateway HTTP API
API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# CloudFront CDN (SPA Hosting)
CLOUDFRONT_URL=https://xxxxxxxxxxxxxx.cloudfront.net

# Amazon Aurora DSQL Database
DSQL_CLUSTER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
DSQL_ENDPOINT=xxxxxxxxxxxxxxxxxxxxxxxxxx.dsql.us-east-1.on.aws
DATABASE_URL=postgres://admin@xxxxxxxxxxxxxxxxxxxxxxxxxx.dsql.us-east-1.on.aws:5432/postgres?sslmode=require

# Event Streaming & Fanout
CDC_KINESIS_STREAM_NAME=familyledger-cdc-stream-dev
EVENT_BUS_NAME=familyledger-events-dev
